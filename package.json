{
  "name": "beamhop-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:e2e": "pnpm --filter @beamhop/pwa run test:e2e",
    "check": "node scripts/check-no-secrets.mjs && pnpm run typecheck && pnpm run lint && pnpm run test",
    "dev:daemon": "tsx apps/daemon/src/main.ts",
    "beamhop": "tsx apps/cli/src/main.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
