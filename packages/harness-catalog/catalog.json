{
  "schema": 1,
  "revision": "2026.11.13.3",
  "harnesses": [
    {
      "id": "claude",
      "displayName": "Claude Code",
      "homepage": "https://code.claude.com/docs",
      "protocol": "claude-sdk",
      "binaries": ["claude"],
      "install": {
        "npm": "@anthropic-ai/claude-code",
        "brew": "claude-code",
        "winget": "Anthropic.ClaudeCode",
        "url": "https://code.claude.com/docs/en/setup",
        "native": {
          "darwin": {
            "kind": "script",
            "url": "https://claude.ai/install.sh"
          },
          "linux": {
            "kind": "script",
            "url": "https://claude.ai/install.sh"
          }
        }
      },
      "installDirs": ["~/.claude/local", "~/.local/bin"],
      "configDirs": ["~/.claude"],
      "auth": {
        "methods": [
          {
            "id": "anthropic-key",
            "label": "Anthropic API key",
            "kind": "broker",
            "secret": "ANTHROPIC_API_KEY",
            "check": "anthropic",
            "hint": "Create one at https://console.anthropic.com/settings/keys"
          },
          {
            "id": "claude-subscription",
            "label": "Claude subscription (Pro / Max)",
            "kind": "broker",
            "secret": "CLAUDE_CODE_OAUTH_TOKEN",
            "check": "anthropic-oauth",
            "hint": "Run `claude setup-token` and paste the token it prints (valid for one year)."
          }
        ],
        "env": [
          "ANTHROPIC_API_KEY",
          "ANTHROPIC_AUTH_TOKEN",
          "CLAUDE_CODE_OAUTH_TOKEN",
          "CLAUDE_CODE_USE_BEDROCK",
          "CLAUDE_CODE_USE_VERTEX"
        ],
        "files": ["~/.claude/.credentials.json"],
        "keychain": ["darwin"],
        "login": "claude /login",
        "note": "On macOS the OAuth login lives in the Keychain and cannot be verified from a file.",
        "loginFlow": {
          "args": ["setup-token"],
          "kind": "browser",
          "capture": {
            "method": "claude-subscription",
            "pattern": "sk-ant-oat01-[A-Za-z0-9_-]{20,}"
          }
        }
      },
      "versionRange": ">=2.0.0",
      "modes": {
        "sdk": {
          "npm": "@anthropic-ai/claude-agent-sdk",
          "note": "Driven in-process with query(); the CLI subprocess is spawned through spawnClaudeCodeProcess."
        },
        "headless": {
          "args": [
            "-p",
            "--output-format",
            "stream-json",
            "--input-format",
            "stream-json",
            "--verbose",
            "--include-partial-messages"
          ]
        },
        "acp": {
          "command": "claude-agent-acp",
          "npm": "@agentclientprotocol/claude-agent-acp",
          "note": "Official ACP adapter (formerly @zed-industries/claude-code-acp)."
        }
      },
      "sources": [
        "https://code.claude.com/docs/en/headless",
        "https://www.npmjs.com/package/@anthropic-ai/claude-agent-sdk",
        "https://github.com/agentclientprotocol/claude-agent-acp"
      ]
    },
    {
      "id": "codex",
      "displayName": "Codex CLI",
      "homepage": "https://developers.openai.com/codex/cli",
      "protocol": "codex-app-server",
      "macosTrustd": true,
      "binaries": ["codex"],
      "install": {
        "npm": "@openai/codex",
        "brew": "codex",
        "url": "https://developers.openai.com/codex/cli"
      },
      "configDirs": ["~/.codex"],
      "auth": {
        "methods": [
          {
            "id": "chatgpt",
            "label": "ChatGPT plan",
            "kind": "home",
            "secret": "CODEX_CHATGPT_LOGIN",
            "hint": "Sign in with the ChatGPT account that has your Plus, Pro, Business, Edu or Enterprise plan.",
            "home": {
              "env": "CODEX_HOME",
              "files": ["auth.json"],
              "seed": [
                {
                  "path": "config.toml",
                  "content": "cli_auth_credentials_store = \"file\"\nforced_login_method = \"chatgpt\"\n"
                }
              ],
              "network": ["chatgpt.com", "auth.openai.com"]
            },
            "signIn": {
              "args": ["login", "-c", "cli_auth_credentials_store=\"file\""],
              "headlessArgs": ["login", "--device-auth", "-c", "cli_auth_credentials_store=\"file\""],
              "statusArgs": ["login", "status", "-c", "cli_auth_credentials_store=\"file\""]
            }
          },
          {
            "id": "openai-key",
            "label": "OpenAI API key",
            "kind": "broker",
            "secret": "OPENAI_API_KEY",
            "check": "openai",
            "hint": "Create one at https://platform.openai.com/api-keys"
          }
        ],
        "env": ["OPENAI_API_KEY", "CODEX_API_KEY"],
        "files": ["~/.codex/auth.json"],
        "login": "codex login"
      },
      "versionRange": ">=0.120.0",
      "modes": {
        "appServer": {
          "args": ["app-server"],
          "note": "JSON-RPC 2.0 over stdio, newline-delimited, without the jsonrpc field. v2 thread/turn API."
        },
        "headless": {
          "args": ["exec", "--json"]
        },
        "acp": {
          "command": "codex-acp",
          "npm": "@agentclientprotocol/codex-acp"
        }
      },
      "sources": [
        "https://developers.openai.com/codex/app-server",
        "https://github.com/openai/codex/tree/main/codex-rs/app-server",
        "https://github.com/agentclientprotocol/codex-acp"
      ]
    },
    {
      "id": "copilot",
      "displayName": "GitHub Copilot CLI",
      "homepage": "https://github.com/features/copilot/cli",
      "protocol": "acp",
      "binaries": ["copilot"],
      "install": {
        "npm": "@github/copilot",
        "brew": "copilot-cli",
        "winget": "GitHub.Copilot",
        "url": "https://docs.github.com/en/copilot/how-tos/copilot-cli/set-up-copilot-cli/install-copilot-cli"
      },
      "configDirs": ["~/.copilot"],
      "homeEnv": "COPILOT_HOME",
      "macosTrustd": true,
      "network": ["api.githubcopilot.com", "*.githubcopilot.com"],
      "auth": {
        "methods": [
          {
            "id": "github-token",
            "label": "GitHub token",
            "kind": "env",
            "secret": "COPILOT_GITHUB_TOKEN",
            "check": "harness",
            "importFrom": "gh",
            "hint": "A fine-grained token with the \"Copilot Requests\" permission (https://github.com/settings/personal-access-tokens), or `gh auth token`. The agent can read it."
          }
        ],
        "env": ["COPILOT_GITHUB_TOKEN", "GH_TOKEN", "GITHUB_TOKEN"],
        "files": ["~/.copilot/config.json"],
        "keychain": ["darwin", "linux", "win32"],
        "login": "copilot login",
        "note": "OAuth token is kept in the system keychain when available; plaintext ~/.copilot/config.json otherwise."
      },
      "versionRange": ">=1.0.0",
      "modes": {
        "acp": {
          "args": ["--acp", "--secret-env-vars=COPILOT_GITHUB_TOKEN,GH_TOKEN,GITHUB_TOKEN"],
          "note": "Public preview; stdio by default, TCP with --port. --secret-env-vars keeps the token out of the shells and MCP servers it starts, and redacts it from output."
        },
        "headless": {
          "args": ["-p"]
        }
      },
      "sources": [
        "https://docs.github.com/en/copilot/reference/copilot-cli-reference/acp-server",
        "https://github.blog/changelog/2026-01-28-acp-support-in-copilot-cli-is-now-in-public-preview/",
        "https://docs.github.com/en/copilot/how-tos/copilot-cli/set-up-copilot-cli/authenticate-copilot-cli"
      ]
    },
    {
      "id": "gemini",
      "displayName": "Gemini CLI",
      "homepage": "https://github.com/google-gemini/gemini-cli",
      "protocol": "acp",
      "binaries": ["gemini"],
      "install": {
        "npm": "@google/gemini-cli",
        "brew": "gemini-cli"
      },
      "configDirs": ["~/.gemini"],
      "network": ["generativelanguage.googleapis.com"],
      "auth": {
        "methods": [
          {
            "id": "google-account",
            "label": "Google account",
            "kind": "home",
            "secret": "GEMINI_GOOGLE_LOGIN",
            "hint": "Sign in with Google (free Gemini Code Assist, or Google AI Pro/Ultra).",
            "home": {
              "env": "GEMINI_CLI_HOME",
              "files": [".gemini/oauth_creds.json"],
              "seed": [
                {
                  "path": ".gemini/settings.json",
                  "content": "{\"security\":{\"auth\":{\"selectedType\":\"oauth-personal\"}}}\n"
                }
              ],
              "network": [
                "cloudcode-pa.googleapis.com",
                "oauth2.googleapis.com",
                "accounts.google.com",
                "www.googleapis.com"
              ]
            },
            "signIn": {
              "args": ["--acp"],
              "captureOpen": true,
              "rpc": [
                {
                  "method": "initialize",
                  "params": {
                    "protocolVersion": 1,
                    "clientCapabilities": {
                      "fs": {
                        "readTextFile": false,
                        "writeTextFile": false
                      }
                    }
                  }
                },
                {
                  "method": "authenticate",
                  "params": {
                    "methodId": "oauth-personal"
                  }
                }
              ]
            }
          },
          {
            "id": "gemini-key",
            "label": "Gemini API key",
            "kind": "env",
            "secret": "GEMINI_API_KEY",
            "check": "gemini",
            "hint": "Create one at https://aistudio.google.com/apikey. The agent can read it."
          }
        ],
        "env": [
          "GEMINI_API_KEY",
          "GOOGLE_API_KEY",
          "GOOGLE_GENAI_USE_VERTEXAI",
          "GOOGLE_APPLICATION_CREDENTIALS"
        ],
        "files": ["~/.gemini/oauth_creds.json"],
        "login": "gemini"
      },
      "versionRange": ">=0.30.0",
      "modes": {
        "acp": {
          "args": ["--acp"],
          "note": "Older releases used --experimental-acp."
        },
        "headless": {
          "args": ["-p", "--output-format", "stream-json"]
        }
      },
      "sources": [
        "https://geminicli.com/docs/cli/acp-mode/",
        "https://agentclientprotocol.com/overview/agents"
      ]
    },
    {
      "id": "opencode",
      "displayName": "OpenCode",
      "homepage": "https://opencode.ai",
      "protocol": "acp",
      "binaries": ["opencode"],
      "install": {
        "npm": "opencode-ai",
        "brew": "sst/tap/opencode",
        "url": "https://opencode.ai/docs"
      },
      "installDirs": ["~/.opencode/bin"],
      "configDirs": ["$XDG_CONFIG_HOME/opencode", "$XDG_DATA_HOME/opencode"],
      "auth": {
        "methods": [
          {
            "id": "chatgpt",
            "label": "ChatGPT plan",
            "kind": "home",
            "secret": "OPENCODE_CHATGPT_LOGIN",
            "hint": "Sign in with the ChatGPT account that has your Plus or Pro plan.",
            "home": {
              "env": "XDG_DATA_HOME",
              "files": ["credentials.json"],
              "extraEnv": {
                "XDG_CONFIG_HOME": "{home}/config",
                "XDG_STATE_HOME": "{home}/state",
                "XDG_CACHE_HOME": "{home}/cache"
              },
              "network": ["auth.openai.com", "chatgpt.com", "api.openai.com"],
              "transfer": {
                "exportArgs": ["auth", "export", "openai", "--standalone"],
                "importArgs": ["auth", "import", "{file}", "--standalone"],
                "file": "credentials.json"
              }
            },
            "signIn": {
              "args": ["auth", "login", "openai", "--method", "chatgpt-browser", "--standalone"],
              "headlessArgs": ["auth", "login", "openai", "--method", "chatgpt-headless", "--standalone"],
              "timeoutSec": 900,
              "captureOpen": true
            }
          },
          {
            "id": "github-copilot",
            "label": "GitHub Copilot",
            "kind": "home",
            "secret": "OPENCODE_COPILOT_LOGIN",
            "hint": "Sign in with the GitHub account that has Copilot (shows a code to confirm).",
            "home": {
              "env": "XDG_DATA_HOME",
              "files": ["credentials.json"],
              "extraEnv": {
                "XDG_CONFIG_HOME": "{home}/config",
                "XDG_STATE_HOME": "{home}/state",
                "XDG_CACHE_HOME": "{home}/cache"
              },
              "network": ["github.com", "api.github.com", "api.githubcopilot.com", "*.githubcopilot.com"],
              "transfer": {
                "exportArgs": ["auth", "export", "github-copilot", "--standalone"],
                "importArgs": ["auth", "import", "{file}", "--standalone"],
                "file": "credentials.json"
              }
            },
            "signIn": {
              "args": [
                "auth",
                "login",
                "github-copilot",
                "--method",
                "device",
                "--answer",
                "deploymentType=github.com",
                "--standalone"
              ],
              "headlessArgs": [
                "auth",
                "login",
                "github-copilot",
                "--method",
                "device",
                "--answer",
                "deploymentType=github.com",
                "--standalone"
              ],
              "timeoutSec": 900,
              "captureOpen": true
            }
          },
          {
            "id": "openrouter-key",
            "label": "OpenRouter API key",
            "kind": "broker",
            "secret": "OPENROUTER_API_KEY",
            "check": "openrouter",
            "hint": "Create one at https://openrouter.ai/keys"
          },
          {
            "id": "anthropic-key",
            "label": "Anthropic API key",
            "kind": "broker",
            "secret": "ANTHROPIC_API_KEY",
            "check": "anthropic",
            "hint": "Create one at https://console.anthropic.com/settings/keys"
          },
          {
            "id": "openai-key",
            "label": "OpenAI API key",
            "kind": "broker",
            "secret": "OPENAI_API_KEY",
            "check": "openai",
            "hint": "Create one at https://platform.openai.com/api-keys"
          }
        ],
        "env": [
          "OPENROUTER_API_KEY",
          "ANTHROPIC_API_KEY",
          "OPENAI_API_KEY",
          "GEMINI_API_KEY",
          "GOOGLE_GENERATIVE_AI_API_KEY",
          "GROQ_API_KEY",
          "XAI_API_KEY"
        ],
        "files": ["$XDG_DATA_HOME/opencode/auth.json"],
        "login": "opencode auth login"
      },
      "versionRange": ">=1.0.0",
      "modes": {
        "acp": {
          "args": ["acp"]
        },
        "headless": {
          "args": ["run", "--format", "json"]
        }
      },
      "sources": [
        "https://opencode.ai/docs/acp/",
        "https://cdn.agentclientprotocol.com/registry/v1/latest/registry.json"
      ]
    },
    {
