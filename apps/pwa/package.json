    "fake-indexeddb": "^6.2.8",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.0",
    "vite": "^7.3.8",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.7"
