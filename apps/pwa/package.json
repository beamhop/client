    "@fontsource-variable/martian-mono": "^5.3.0",
    "@fontsource/doto": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "motion": "^14.13.0",
    "nostr-tools": "^2.17.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-aria-components": "^1.22.1",
